// Project-local debug scenarios.
//
// Zed runs on the host; the CodeLLDB adapter runs inside the Docker container
// (see .zed/docker.sh). Zed connects to it over TCP, so the adapter must be
// listening on 127.0.0.1:12345 first. The `build` step below both builds the
// target and starts the adapter, so a normal debug launch is self-contained.
//
// For more documentation on how to configure debug scenarios,
// see: https://zed.dev/docs/debugger
[
    {
        "label": "Debug PlanetaryScan (Docker)",
        "adapter": "CodeLLDB",
        "request": "launch",
        "tcp_connection": {
            "host": "127.0.0.1",
            "port": 12345
        },
        "build": {
            "command": "bash",
            "args": [
                "-c",
                ".zed/docker.sh cmake --build build && .zed/docker.sh --debug-adapter",
            ],
            "cwd": "$ZED_MAIN_GIT_WORKTREE",
        },
        "program": "$ZED_MAIN_GIT_WORKTREE/build/examples/planetaryscan/example-planetaryscan",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "args": [],
        "env": {},
        "stopOnEntry": false,
    },
    {
        "label": "Debug CircularWave3D (Docker)",
        "adapter": "CodeLLDB",
        "request": "launch",
        "tcp_connection": {
            "host": "127.0.0.1",
            "port": 12345
        },
        "build": {
            "command": "bash",
            "args": [
                "-c",
                ".zed/docker.sh cmake --build build && .zed/docker.sh --debug-adapter",
            ],
            "cwd": "$ZED_MAIN_GIT_WORKTREE",
        },
        "program": "$ZED_MAIN_GIT_WORKTREE/build/examples/circularwave3d/example-circularwave3d",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "args": [],
        "env": {},
        "stopOnEntry": false,
    },
]
