// Project-local debug scenarios.
//
// Zed runs on the host; the CodeLLDB adapter runs inside the Docker container
// (see settings.json) and talks to Zed over stdio.
//
// For more documentation on how to configure debug scenarios,
// see: https://zed.dev/docs/debugger
[
    {
        "label": "Debug PlanetaryScan (Docker)",
        "adapter": "CodeLLDB",
        "request": "launch",
        "build": {
            "command": "bash",
            "args": [
                "-c",
                "sudo devcontainer up --workspace-folder . --config .devcontainer/nvidia/devcontainer.json && sudo devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake --build build",
            ],
            "cwd": "$ZED_MAIN_GIT_WORKTREE",
        },
        "program": "$ZED_MAIN_GIT_WORKTREE/build/examples/planetaryscan/example-planetaryscan",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "args": [],
        "env": {},
        "stopOnEntry": false,
    },
    {
        "label": "Debug CircularWave3D (Docker)",
        "adapter": "CodeLLDB",
        "request": "launch",
        "build": {
            "command": "bash",
            "args": [
                "-c",
                "sudo devcontainer up --workspace-folder . --config .devcontainer/nvidia/devcontainer.json && sudo devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake --build build",
            ],
            "cwd": "$ZED_MAIN_GIT_WORKTREE",
        },
        "program": "$ZED_MAIN_GIT_WORKTREE/build/examples/circularwave3d/example-circularwave3d",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "args": [],
        "env": {},
        "stopOnEntry": false,
    },
]
