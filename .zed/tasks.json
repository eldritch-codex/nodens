// See https://zed.dev/docs/tasks for documentation.
//
// Zed runs on the host; every task below executes inside the Docker container
// defined by .devcontainer/nvidia or .devcontainer/dri (chosen by .zed/docker.sh,
// override with NODENS_GPU). See .zed/docker.sh for the
// container lifecycle (it is created on first use and reused afterwards).
[
    {
        "label": "[Nodens] Docker: Start",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash $ZED_MAIN_GIT_WORKTREE/.zed/docker.sh true",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "on_success",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Docker: Stop",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "docker stop eldritchcodex-nodens",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "on_success",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Docker: Restart Debug Adapter",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh --debug-adapter",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "on_success",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Config Debug",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Config Release",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh cmake -B build -S . -DCMAKE_BUILD_TYPE=Release",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Config Profiling",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh cmake -B build -S . -DCMAKE_BUILD_TYPE=Profiling -DND_BUILD_TRACY_PROFILER=ON",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Build",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh cmake --build build -j4",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Build Clean",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh cmake --build build --clean-first -j4",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Build Tracy Profiler",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh cmake --build build --target tracy-profiler",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Run PlanetaryScan",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh ./build/examples/planetaryscan/example-planetaryscan",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Run CircularWave3D",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "bash .zed/docker.sh ./build/examples/circularwave3d/example-circularwave3d",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
]
