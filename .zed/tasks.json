// See https://zed.dev/docs/tasks for documentation.
//
// Zed runs on the host; every task below executes inside the dev container with
// the Dev Containers CLI (npm i -g @devcontainers/cli). Run "Docker: Start" once
// per session. The tasks use the NVIDIA config; for Intel/AMD replace "nvidia"
// with "dri" in .zed/tasks.json, .zed/debug.json and .zed/settings.json.
[
    {
        "label": "[Nodens] Docker: Start",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer up --workspace-folder . --config .devcontainer/nvidia/devcontainer.json",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "on_success",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Docker: Stop",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "docker stop eldritch-codex-nodens-nvidia",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "on_success",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Config Debug",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Config Release",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake -B build -S . -DCMAKE_BUILD_TYPE=Release",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Config Profiling",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake -B build -S . -DCMAKE_BUILD_TYPE=Profiling -DND_BUILD_TRACY_PROFILER=ON",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Build",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake --build build -j4",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Build Clean",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake --build build --clean-first -j4",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Build Tracy Profiler",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json cmake --build build --target tracy-profiler",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Run PlanetaryScan",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json ./build/examples/planetaryscan/example-planetaryscan",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Run CircularWave3D",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json ./build/examples/circularwave3d/example-circularwave3d",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
    {
        "label": "[Nodens] Run TracyProfiler",
        "cwd": "$ZED_MAIN_GIT_WORKTREE",
        "command": "devcontainer exec --workspace-folder . --config .devcontainer/nvidia/devcontainer.json ./build/tracy-profiler/bin/tracy-profiler",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "reveal_target": "dock",
        "hide": "never",
        "shell": "system",
        "show_summary": true,
        "show_command": true,
        "save": "none",
    },
]
